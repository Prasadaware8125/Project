<% layout("/layouts/boilerplate") %>
    
    <div class="row">
        <div class="col-8 offset-2">
            <h2>Create New List!</h2>
            <br><br>
            <form action="/listings" method="post">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input id="title" type="text" name="listing[title]" placeholder="Add catchy title" class="form-control">
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea id="description" name="listing[description]" placeholder="enter description" rows="5"
                    class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <label for="image" class="form-label">Image</label>
                <input id="image" type="text" name="listing[image]" placeholder="Enter image URL/Link"
                    class="form-control">
            </div>
            <div class="row">
                    <div class="mb-3 col-md-6">
                        <label for="price" class="form-label">Price</label>
                        <input id="price" type="number" name="listing[price]" placeholder="1200" class="form-control">
                    </div>
                    <div class="mb-3 col-md-6">
                        <label for="country" class="form-label">Country</label>
                        <input id="country" type="text" name="listing[country]" placeholder="India" class="form-control">
                    </div>
            </div>
            <div class="mb-3">
                <label for="location" class="form-label">Locations</label>
                <input id="location" type="text" name="listing[location]" placeholder="Mumbai, Maharastrha"
                    class="form-control">
            </div>
            <button class="btn btn-dark add-btn">Add</button>
            <br><br>
        </form>
        </div>
    </div>